# IMS
IMS_BASE_URL= Your IMS API base URL
IMS_API_TOKEN= Your IMS API token
IMS_REQUEST_TIMEOUT=10

# PostgreSQL / Neon
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/neondb?sslmode=require
ENABLE_DEMO_DATA_RESET=true
ENABLE_SIMULATION_CONTROL_API=true

# GROQ
GROQ_API_KEY= Your GROQ API key

# NASA FIRMS
FIRMS_MAP_KEY= Your FIRMS MAP key
FIRMS_BASE_URL= Your FIRMS API base URL
FIRMS_SOURCE=VIIRS_NOAA20_NRT
FIRMS_DAY_RANGE=1
FIRMS_REQUEST_TIMEOUT=10

FIRMS_WEST=34.0
FIRMS_SOUTH=29.4
FIRMS_EAST=35.9
FIRMS_NORTH=33.4

COPERNICUS_CLIENT_ID= Your COPERNICUS Client ID
COPERNICUS_CLIENT_SECRET= Your COPERNICUS Client Secret
COPERNICUS_TOKEN_URL= Your COPERNICUS Token URL
COPERNICUS_STATISTICS_URL= Your COPERNICUS Statistics URL
COPERNICUS_LAND_COVER_COLLECTION_ID= Your COPERNICUS Land Cover Collection ID

FIRE_DETECTION_DECISION_MODE=ai_hybrid_v5

# Gemini
GEMINI_API_KEY= Your GEMINI API key
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_FALLBACK_MODEL=gemma-4-26b-a4b-it