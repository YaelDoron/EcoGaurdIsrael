IMS_BASE_URL=https://api.ims.gov.il/v1/envista
IMS_API_TOKEN=
IMS_REQUEST_TIMEOUT=10

FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
FIRMS_MAP_KEY=
FIRMS_SOURCE=VIIRS_NOAA20_NRT
FIRMS_DAY_RANGE=1
FIRMS_REQUEST_TIMEOUT=10
FIRMS_WEST=34.0
FIRMS_SOUTH=29.4
FIRMS_EAST=35.9
FIRMS_NORTH=33.4

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Guards DemoStateResetService (backend/src/simulation/demo_state_reset_service.py)
# and `python -m scripts.reset_demo_state`. Leave false everywhere except a
# dedicated, disposable demo database/Neon branch - this is a destructive
# reset of runtime wildfire/planning data, never intended for the shared
# team development database.
ENABLE_DEMO_DATA_RESET=false

# Guards the Simulation Control API (POST/GET /api/v1/simulation/...) added
# in Task A3. Separate from ENABLE_DEMO_DATA_RESET above - this only
# controls whether the simulation-control endpoints exist/respond at all;
# a start request with reset_demo_state=true still requires
# ENABLE_DEMO_DATA_RESET=true independently. The dev server must also run
# with a single worker (e.g. `uvicorn ... --workers 1`) since run state is
# held in-process, not in the database.
ENABLE_SIMULATION_CONTROL_API=false

# Comma-separated list of origins allowed to call the API (CORS).
FRONTEND_ORIGINS=http://localhost:5173

COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_STATISTICS_URL=https://sh.dataspace.copernicus.eu/statistics/v1
COPERNICUS_LAND_COVER_COLLECTION_ID=35fecfec-8a73-4723-bb08-b775f283a535
COPERNICUS_REQUEST_TIMEOUT=20

GEMINI_API_KEY=
