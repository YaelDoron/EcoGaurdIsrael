
# Copy this file to .env and fill in real values. Never commit the real .env.

# Required if llm.provider == "groq" in configs/news_config.yaml
# To get your free API key:
# 1. Go to https://console.groq.com/keys
# 2. Log in and click "Create API Key"
# 3. Copy the generated key and paste it here (without quotes or spaces)
GROQ_API_KEY=your_groq_api_key_here

IMS_BASE_URL=https://api.ims.gov.il/v1/envista
IMS_API_TOKEN=
IMS_REQUEST_TIMEOUT=10

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

